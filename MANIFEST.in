include README.md requirements.txt run_pipeline.py
recursive-include docs *.md
recursive-include tests *.py
recursive-include coursework *.py *.md
recursive-include reports *.py *.md
recursive-include code *.py *.md
prune .venv
prune artifacts
prune build
prune dataset
prune results
prune code/output
prune code/final/plots
global-exclude __pycache__ *.py[cod]
